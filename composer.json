{
    "name": "rushing/codegen",
    "description": "A framework-free kernel for language-neutral code generation: a fluent semantic meta-model (records, operations, type-kinds) hydrated from JSON Schema, driven to any target by generators that are popcorn invocables.",
    "keywords": [
        "codegen",
        "code-generation",
        "meta-model",
        "invocable",
        "sdk",
        "schema",
        "registry"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "rushing/php-popcorn": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0",
        "rushing/php-package-topology": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Codegen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "package-topology": {
            "mustRequire": [
                "rushing/php-popcorn"
            ],
            "mustNotRequire": [
                "illuminate/*"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-graphine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-package-topology.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    }
}
